{
  "name": "chatgpt-autopilot",
  "private": true,
  "license": "MIT",
  "version": "0.3.0",
  "type": "module",
  "description": "Chrome extension (MV3) that automatically sends a continuation prompt each time ChatGPT finishes a response.",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e": "npm run build && node e2e/extension.e2e.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
